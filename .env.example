# =============================================================================
# AI Router - Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Required for Production ---

# Admin dashboard password (default: 'admin' if not set)
# IMPORTANT: Change this in production!
ADMIN_PASSWORD=your-secure-admin-password-here

# Encryption key for API keys at rest (AES-256-GCM)
# Should be 32+ characters, random and secret
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-random-encryption-key-here

# --- Optional: Persistent Storage (Recommended for Vercel) ---

# Upstash Redis - Recommended for Vercel deployment
# Get these from Vercel Marketplace: https://vercel.com/marketplace/upstash
# Or create at https://console.upstash.com/
# When you add Upstash Redis integration in Vercel, these are auto-set
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Alternative: Vercel KV (deprecated but still works)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# --- Optional: Customization ---

# Custom storage file path (for local development)
# Default: ./data/storage.json
# STORAGE_PATH=./data/storage.json

# Disable authentication (for local development only!)
# Set to 'true' to bypass login - NEVER use in production
# DISABLE_AUTH=false

# Node environment
# NODE_ENV=production
